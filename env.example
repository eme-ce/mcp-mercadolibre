# ============================================================
#  Servidor MCP de MercadoLibre — Variables de entorno
#  Copiá este archivo a .env y completá tus valores. Nunca subirlo a github!
# ============================================================

# ----------------------------------------------------------
# REQUERIDO: Credenciales de la aplicación de MercadoLibre
# Creá tu app en: https://developers.mercadolibre.com.ar/apps
# ----------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ----------------------------------------------------------
# REQUERIDO: URI de redirección de OAuth
# Debe coincidir exactamente con lo registrado en tu app de ML.
# Para Railway: https://tu-app.up.railway.app/auth/callback
# Para local:   http://localhost:8000/auth/callback
# ----------------------------------------------------------
ML_REDIRECT_URI=https://tu-app.up.railway.app/auth/callback

# ----------------------------------------------------------
# OPCIONAL: Tokens de acceso de ML (se completan después del primer flujo de OAuth)
# Después de visitar /auth/url y completar la pantalla de consentimiento,
# el servidor registra ambos tokens en el log. Pegalos acá para que sobrevivan a los reinicios.
# ----------------------------------------------------------
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# ----------------------------------------------------------
# OPCIONAL: ID del sitio (por defecto: MLA para Argentina)
# Otras opciones: MLB (Brasil), MLM (México), MLC (Chile), etc.
# ----------------------------------------------------------
ML_SITE=MLA

# ----------------------------------------------------------
# REQUERIDO: Token de seguridad
# Los clientes deben enviarlo como: Authorization: Bearer <token>
# Usá una cadena aleatoria larga (ej. openssl rand -hex 32)
# ----------------------------------------------------------
BEARER_TOKEN=

# ----------------------------------------------------------
# OPCIONAL: Ajustes de seguridad
# ALLOW_TOKEN_QUERY_PARAM — Poner en 1 solo si tu cliente MCP no puede enviar headers
# MAX_REQUEST_BODY        — Tamaño máximo del cuerpo entrante en bytes (por defecto: 1048576 = 1 MB)
# RATE_LIMIT_RPM          — Máximo de requests por minuto por IP (por defecto: 60)
# RATE_LIMIT_MAX_IPS      — Máximo de IPs rastreadas por el limitador de tasa (por defecto: 10000)
# TRUSTED_PROXY_COUNT     — Cuántos proxies inversos hay delante del servidor (por defecto: 1)
# TOKEN_REFRESH_BUFFER    — Segundos antes del vencimiento del token para disparar una renovación (por defecto: 1800)
# ----------------------------------------------------------
ALLOW_TOKEN_QUERY_PARAM=
MAX_REQUEST_BODY=1048576
RATE_LIMIT_RPM=60
RATE_LIMIT_MAX_IPS=10000
TRUSTED_PROXY_COUNT=1
TOKEN_REFRESH_BUFFER=1800

# ----------------------------------------------------------
# OPCIONAL: Configuración del servidor
# PORT          — El puerto en el que corre el servidor MCP (por defecto: 8000)
# MCP_TRANSPORT — Dejalo como streamable-http para usar con Claude.ai
# ----------------------------------------------------------
PORT=8000
MCP_TRANSPORT=streamable-http
