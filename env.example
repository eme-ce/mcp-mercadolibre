# ============================================================
#  MercadoLibre MCP Server — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit your real .env file to GitHub!
# ============================================================

# ----------------------------------------------------------
# REQUIRED: MercadoLibre application credentials
# Create your app at: https://developers.mercadolibre.com.ar/apps
# ----------------------------------------------------------
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ----------------------------------------------------------
# REQUIRED: OAuth redirect URI
# Must match exactly what you registered in your ML app.
# For Railway: https://your-app.up.railway.app/auth/callback
# For local:   http://localhost:8000/auth/callback
# ----------------------------------------------------------
ML_REDIRECT_URI=https://your-app.up.railway.app/auth/callback

# ----------------------------------------------------------
# OPTIONAL: ML access tokens (populated after first OAuth flow)
# After visiting /auth/url and completing the consent screen,
# the server logs both tokens. Paste them here so they survive restarts.
# ----------------------------------------------------------
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# ----------------------------------------------------------
# OPTIONAL: Site ID (default: MLA for Argentina)
# Other options: MLB (Brazil), MLM (Mexico), MLC (Chile), etc.
# ----------------------------------------------------------
ML_SITE=MLA

# ----------------------------------------------------------
# REQUIRED: Security token
# Clients must send this as: Authorization: Bearer <token>
# Use a long random string (e.g. openssl rand -hex 32)
# ----------------------------------------------------------
BEARER_TOKEN=

# ----------------------------------------------------------
# OPTIONAL: Security tuning
# ALLOW_TOKEN_QUERY_PARAM — Set to 1 only if your MCP client cannot send headers
# MAX_REQUEST_BODY        — Max incoming body size in bytes (default: 1048576 = 1 MB)
# RATE_LIMIT_RPM          — Max requests per minute per IP (default: 60)
# RATE_LIMIT_MAX_IPS      — Max IPs tracked by rate limiter (default: 10000)
# TRUSTED_PROXY_COUNT     — How many reverse proxies sit in front (default: 1)
# TOKEN_REFRESH_BUFFER    — Seconds before token expiry to trigger refresh (default: 1800)
# ----------------------------------------------------------
ALLOW_TOKEN_QUERY_PARAM=
MAX_REQUEST_BODY=1048576
RATE_LIMIT_RPM=60
RATE_LIMIT_MAX_IPS=10000
TRUSTED_PROXY_COUNT=1
TOKEN_REFRESH_BUFFER=1800

# ----------------------------------------------------------
# OPTIONAL: Server configuration
# PORT          — The port the MCP server runs on (default: 8000)
# MCP_TRANSPORT — Keep as streamable-http for use with Claude.ai
# ----------------------------------------------------------
PORT=8000
MCP_TRANSPORT=streamable-http
